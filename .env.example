# Prefer: node scripts/setup-env.cjs (creates matching random credentials).
# For manual setup, copy this file to .env and replace every placeholder.
PORT=3000
MONGO_ROOT_USERNAME=profile_admin
MONGO_ROOT_PASSWORD=REPLACE_DATABASE_PASSWORD
# Use the same database password in both URIs, URL-encoded if necessary.
MONGODB_URI='mongodb://profile_admin:REPLACE_DATABASE_PASSWORD@127.0.0.1:27017/?authSource=admin'
MONGO_EXPRESS_URI='mongodb://profile_admin:REPLACE_DATABASE_PASSWORD@mongodb:27017/?authSource=admin'
MONGODB_DB=user
MONGODB_COLLECTION=users
MONGO_EXPRESS_WEB_USERNAME=viewer
MONGO_EXPRESS_WEB_PASSWORD=REPLACE_WEB_PASSWORD
# Local build by default; use singhania8192/profile-app:1.0 to pull the release.
APP_IMAGE=profile-app:local
